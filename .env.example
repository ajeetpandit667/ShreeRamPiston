# Copy this file to .env and fill values for local development
# Do NOT commit real credentials to source control.

# SMTP (Mailtrap example)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=<mailtrap_user>
SMTP_PASS=<mailtrap_password>
SMTP_TLS=True
SMTP_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Gmail example (use an App Password if 2FA is enabled)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=<your_app_password>
# SMTP_TLS=True
# SMTP_SSL=False

# Optional: Twilio (if you use SMS notifications)
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH=your_twilio_auth_token
# TWILIO_FROM=+1234567890
